/tmp/*
  X-Robots-Tag: noindex, nofollow, noimageindex

/water-sort/
  Cache-Control: public, max-age=0, must-revalidate

/water-sort/assets/*
  Cache-Control: public, max-age=31536000, immutable

/water-sort-src/*
  X-Robots-Tag: noindex, nofollow, noimageindex

/water-sort/README*
  X-Robots-Tag: noindex, nofollow

/water-sort/sounds/v1/*
  Cache-Control: public, max-age=31536000, immutable

/water-sort/sounds/v2/*
  Cache-Control: public, max-age=31536000, immutable

/water-sort/*.png
  Cache-Control: public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400

/water-sort/*.webp
  Cache-Control: public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400

/blockpang/tmp-screenshots/*
  X-Robots-Tag: noindex, nofollow, noimageindex

/seo/_*
  X-Robots-Tag: noindex, nofollow, noimageindex

/solo-leveling/asset-preview-light-swordswoman*
  X-Robots-Tag: noindex, nofollow, noimageindex

/school-zombie-defense
  Cache-Control: public, max-age=0, must-revalidate

/school-zombie-defense/
  Cache-Control: public, max-age=0, must-revalidate

/school-zombie-defense/*.html
  Cache-Control: public, max-age=0, must-revalidate

/school-zombie-defense/js/*
  Cache-Control: public, max-age=0, must-revalidate

/school-zombie-defense/css/*
  Cache-Control: public, max-age=0, must-revalidate

/school-zombie-defense/assets/images/*
  Cache-Control: public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400

/school-zombie-defense/assets/sounds/*
  Cache-Control: public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400

/blockpang/assets/ui/*
  Cache-Control: public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400

# Title UI is not content-hashed, so keep the same week-long browser cache as blockpang.
/jewelria/assets/images/ui/*
  Cache-Control: public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400

/cat-tower/assets/ui/*
  Cache-Control: public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400

/blockpang/sounds/*
  Cache-Control: public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400

# Keep the Cloudflare Pages production subdomain and repository inputs out of search.
https://archerlab-games.pages.dev/*
  X-Robots-Tag: noindex, follow

/package*.json
  X-Robots-Tag: noindex, nofollow

/wrangler*.toml
  X-Robots-Tag: noindex, nofollow

/AGENTS.md
  X-Robots-Tag: noindex, nofollow

/CLAUDE.md
  X-Robots-Tag: noindex, nofollow

/README*
  X-Robots-Tag: noindex, nofollow

/scripts/*
  X-Robots-Tag: noindex, nofollow

/tests/*
  X-Robots-Tag: noindex, nofollow
